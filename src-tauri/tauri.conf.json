{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PLaMo PDF Translator",
  "version": "0.1.0",
  "identifier": "jp.local.plamo.pdf-translator",
  "build": {
    "beforeDevCommand": "pnpm run dev:renderer",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm run build:renderer",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "PLaMo PDF Translator",
        "width": 1500,
        "height": 940,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "backgroundColor": "#111418",
        "dragDropEnabled": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; worker-src 'self' blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "../LICENSE": "licenses/LICENSE",
      "../THIRD_PARTY_NOTICES.md": "licenses/THIRD_PARTY_NOTICES.md",
      "../THIRD_PARTY_LICENSES.txt": "licenses/THIRD_PARTY_LICENSES.txt",
      "../licenses/PLAMO_COMMUNITY_LICENSE-ja.txt": "licenses/PLAMO_COMMUNITY_LICENSE-ja.txt",
      "../licenses/PLAMO_COMMUNITY_LICENSE-en.txt": "licenses/PLAMO_COMMUNITY_LICENSE-en.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "publisher": "PLaMo PDF Translator",
    "shortDescription": "Offline PDF translator",
    "longDescription": "Offline academic PDF translator running PLaMo 3 Translate 0.8B locally through llama.cpp.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Japanese", "English"]
      }
    }
  }
}
